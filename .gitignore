# dependencies
node_modules/

# next/open-next/cloudflare build output
.next/
# Keep only the assets bootstrap marker so Wrangler can validate a fresh checkout
# before its build.command generates the real OpenNext output.
.open-next/*
!.open-next/assets/
.open-next/assets/*
!.open-next/assets/.gitkeep
.wrangler/

# local environment values
.env
.env.local
.env.*.local
.dev.vars

# test/coverage output
coverage/

# OS/editor
.DS_Store
*.log

# generated Cloudflare types
cloudflare-env.d.ts
