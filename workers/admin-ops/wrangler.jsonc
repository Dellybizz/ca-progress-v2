{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "ca-progress-v2-admin-ops",
  "main": "./index.ts",
  "minify": true,
  "compatibility_date": "2026-08-29",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "keep_vars": true,
  "r2_buckets": [
    { "binding": "USER_RESOURCES_R2", "bucket_name": "ca-progress-v2-staging-user-resources" }
  ],
  "services": [
    { "binding": "BILLING_SERVICE", "service": "ca-progress-v2-billing" }
  ],
  "observability": { "enabled": true }
}
