{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ca-progress-v2-phase3-validation",
  "main": "./custom-worker.ts",
  "minify": true,
  "compatibility_date": "2026-08-29",
  "compatibility_flags": ["nodejs_compat"],
  "keep_vars": true,
  "assets": { "binding": "ASSETS", "directory": ".open-next/assets" },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "ca-progress-v2-phase3-local",
    "database_id": "00000000-0000-0000-0000-000000000000",
    "migrations_dir": "d1/migrations",
    "migrations_table": "d1_migrations"
  }],
  "r2_buckets": [{ "binding": "USER_RESOURCES_R2", "bucket_name": "ca-progress-v2-staging-user-resources" }],
  "services": [
    { "binding": "ICAI_SYNC_SERVICE", "service": "icai-sync-worker" },
    { "binding": "BILLING_SERVICE", "service": "billing-worker" }
  ],
  "queues": {
    "producers": [{ "binding": "BACKGROUND_JOBS", "queue": "ca-progress-v2-phase3-background" }],
    "consumers": [{
      "queue": "ca-progress-v2-phase3-background",
      "max_batch_size": 5,
      "max_batch_timeout": 5,
      "max_retries": 5
    }]
  },
  "triggers": { "crons": ["30 0 * * *"] },
  "vars": {
    "NEXT_PUBLIC_APP_NAME": "CA Progress",
    "NEXT_PUBLIC_APP_ENV": "staging",
    "NEXT_PUBLIC_APP_VERSION": "migration-phase-3",
    "CA_AUTH_RUNTIME": "cloudflare"
  },
  "observability": { "enabled": true }
}
