{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ca-progress-v2",
  "main": "./custom-worker.ts",
  "minify": true,
  "compatibility_date": "2026-08-29",
  "compatibility_flags": ["nodejs_compat"],
  "keep_vars": true,
  "secrets": { "required": ["SUPABASE_SERVICE_ROLE_KEY"] },
  "assets": { "binding": "ASSETS", "directory": ".open-next/assets" },
  "services": [
    { "binding": "CORE_WEB_SERVICE", "service": "ca-progress-v2-web-core" },
    { "binding": "ADMIN_WEB_SERVICE", "service": "ca-progress-v2-web-admin" },
    { "binding": "COMMUNITY_WEB_SERVICE", "service": "ca-progress-v2-web-community" },
    { "binding": "PLANNING_WEB_SERVICE", "service": "ca-progress-v2-web-planning" },
    { "binding": "ICAI_SYNC_SERVICE", "service": "ca-progress-v2-icai-sync" }
  ],
  "triggers": { "crons": ["30 0 * * *"] },
  "vars": {
    "NEXT_PUBLIC_APP_NAME": "CA Progress",
    "NEXT_PUBLIC_APP_ENV": "staging",
    "NEXT_PUBLIC_APP_VERSION": "phase-12"
  },
  "observability": { "enabled": true }
}
