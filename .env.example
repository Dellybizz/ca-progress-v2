# CA Progress V2 - local/staging template
# Never point these values at the legacy CA Progress production project.

NEXT_PUBLIC_APP_NAME=CA Progress
NEXT_PUBLIC_APP_ENV=staging
NEXT_PUBLIC_APP_VERSION=phase-3

# New, isolated V2 Supabase project only
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional server-only key. Required only when service-role features such as database health logging are enabled.
SUPABASE_SERVICE_ROLE_KEY=

# Optional health logging switch.
HEALTH_LOG_DB=false
