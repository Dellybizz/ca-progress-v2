# CA Progress V2 - local/staging template
# Never point these values at the legacy CA Progress production project.

NEXT_PUBLIC_APP_NAME=CA Progress
NEXT_PUBLIC_APP_ENV=staging
NEXT_PUBLIC_APP_VERSION=phase-10

# New, isolated V2 Supabase project only.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only V2 key retained for protected metadata/admin work, Phase 8 sync,
# Phase 7 resource metadata, Phase 9 planner generation/history, and server-only
# Community moderation/query work where the service-role client is appropriate.
# Never expose this as NEXT_PUBLIC_*.
SUPABASE_SERVICE_ROLE_KEY=

# Phase 8 protected scheduler secret retained unchanged.
ICAI_CRON_SECRET=

# Optional Phase 8 runtime controls retained by later phases.
ICAI_SYNC_ENABLED=true
ICAI_SYNC_USER_AGENT=CA Progress V2 Official ICAI Monitor/phase8

# Optional health logging switch.
HEALTH_LOG_DB=false

# Phase 10 Community uses the existing Supabase public client for scoped Realtime
# subscriptions and adds no new secret or external-service environment variable.
