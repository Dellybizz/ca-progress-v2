# CA Progress V2 - local/staging template
# Never point these values at the legacy CA Progress production project.

NEXT_PUBLIC_APP_NAME=CA Progress
NEXT_PUBLIC_APP_ENV=staging
NEXT_PUBLIC_APP_VERSION=phase-0

# New, isolated V2 Supabase project only
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Configure as a Cloudflare Worker secret in staging.
SUPABASE_SERVICE_ROLE_KEY=

# Optional health logging switch; leave false until the V2 database is linked.
HEALTH_LOG_DB=false
