# CA Progress V2 - local/staging template
# Never point these values at the legacy CA Progress production project.

NEXT_PUBLIC_APP_NAME=CA Progress
NEXT_PUBLIC_APP_ENV=staging
NEXT_PUBLIC_APP_VERSION=phase-4

# New, isolated V2 Supabase project only.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only V2 key. Phase 8 source synchronization, private sync monitoring
# and review operations require this. Phase 4 dashboard reads only verified
# public reference data plus the signed-in user's RLS-protected profile.
# Never expose this as NEXT_PUBLIC_*.
SUPABASE_SERVICE_ROLE_KEY=

# Phase 8 protected scheduler secret. Generate a strong random value and keep it
# only in server/Cloudflare secret storage. Never commit a real value.
ICAI_CRON_SECRET=

# Optional Phase 8 runtime controls retained by Phase 4.
ICAI_SYNC_ENABLED=true
ICAI_SYNC_USER_AGENT=CA Progress V2 Official ICAI Monitor/phase8

# Optional health logging switch.
HEALTH_LOG_DB=false
