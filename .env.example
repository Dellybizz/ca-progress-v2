# CA Progress V2 - local/staging template
# Never point these values at the legacy CA Progress production project.

NEXT_PUBLIC_APP_NAME=CA Progress
NEXT_PUBLIC_APP_ENV=staging
NEXT_PUBLIC_APP_VERSION=phase-2

# New, isolated V2 Supabase project only
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Required for Phase 2 application-level phone OTP rate limiting.
SUPABASE_SERVICE_ROLE_KEY=
# Strong random secret, minimum 32 characters. Used only to hash phone/IP rate-limit identifiers.
AUTH_RATE_LIMIT_SALT=

# Optional health logging switch.
HEALTH_LOG_DB=false
