# CA Progress V2 - local/staging template
# Cloudflare is the authoritative application runtime.

NEXT_PUBLIC_APP_NAME=CA Progress
NEXT_PUBLIC_APP_ENV=staging
NEXT_PUBLIC_APP_VERSION=phase-11

# Cloudflare authentication/session configuration. Keep secrets server-side.
# CA_AUTH_RUNTIME=cloudflare
# CA_AUTH_SESSION_SECRET=generate-a-long-random-server-secret
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# LINKEDIN_OIDC_CLIENT_ID=
# LINKEDIN_OIDC_CLIENT_SECRET=

# Phase 8 compatibility cron secret and runtime controls.
ICAI_CRON_SECRET=
ICAI_SYNC_ENABLED=true
ICAI_SYNC_USER_AGENT=CA Progress V2 Official ICAI Monitor/phase8

# Optional health/performance logging switches.
HEALTH_LOG_DB=false
# CA_PERF_LOGGING=true

# Phase 11 provider credentials belong on the PRIVATE ca-progress-v2-billing Worker.
# Do not commit values and do not expose key secrets as NEXT_PUBLIC_*.
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
#
# The browser receives only the public Razorpay key ID from a server-created order response.
# Paid plan amounts remain server-side in subscription_plans.price_subunits.

# Direct-to-R2 SigV4 signing. Configure these as Worker secrets, never NEXT_PUBLIC_*.
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# Optional custom S3 endpoint; defaults to https://<account-id>.r2.cloudflarestorage.com
# R2_S3_ENDPOINT=
