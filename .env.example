# CA Progress V2 - local/staging template
# Never point these values at the legacy CA Progress production project.

NEXT_PUBLIC_APP_NAME=CA Progress
NEXT_PUBLIC_APP_ENV=staging
NEXT_PUBLIC_APP_VERSION=phase-12

# New, isolated V2 Supabase project only.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only V2 key retained for protected metadata/admin work and internal Worker calls.
# Never expose this as NEXT_PUBLIC_*.
SUPABASE_SERVICE_ROLE_KEY=

# Phase 8 compatibility cron secret and runtime controls.
ICAI_CRON_SECRET=
ICAI_SYNC_ENABLED=true
ICAI_SYNC_USER_AGENT=CA Progress V2 Official ICAI Monitor/phase8

# Optional health logging switch.
HEALTH_LOG_DB=false

# Phase 11 provider credentials remain on the PRIVATE ca-progress-v2-billing Worker.
# Phase 12 reads only its private /health probe; no Razorpay secret is exposed to admin pages.
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
#
# Phase 12 introduces no new required secret. Existing privileged V2 JWT roles are
# bootstrapped into admin_users by the migration. If no parent_owner already exists,
# bootstrap one deliberately with the service-role-only phase12_bootstrap_parent_owner RPC.
