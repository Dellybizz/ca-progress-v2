{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ca-progress-v2-phase4-validation",
  "main": "custom-worker.ts",
  "compatibility_date": "2026-08-28",
  "compatibility_flags": ["nodejs_compat"],
  "keep_vars": true,
  "d1_databases": [{"binding":"DB","database_name":"ca-progress-v2-phase4-local","database_id":"00000000-0000-0000-0000-000000000000","migrations_dir":"d1/migrations"}],
  "r2_buckets": [{"binding":"USER_RESOURCES_R2","bucket_name":"ca-progress-v2-staging-user-resources"}],
  "queues": {"producers":[{"binding":"BACKGROUND_JOBS","queue":"ca-progress-v2-phase3-background"}],"consumers":[{"queue":"ca-progress-v2-phase3-background","max_batch_size":10,"max_batch_timeout":5,"max_retries":5,"dead_letter_queue":"ca-progress-v2-phase3-background-dlq"}]},
  "services": [{"binding":"ICAI_SYNC_SERVICE","service":"ca-progress-v2-icai-sync"},{"binding":"BILLING_SERVICE","service":"ca-progress-v2-billing"}],
  "triggers": {"crons":["30 0 * * *"]},
  "vars": {"NEXT_PUBLIC_APP_ENV":"staging","CA_AUTH_RUNTIME":"cloudflare","CA_PHASE4_SHADOW_READ":"1"}
}
