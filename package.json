{
  "name": "ca-progress-v2",
  "version": "0.0.1",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "node --test tests/*.test.mjs",
    "test:smoke": "node --test tests/phase0-*.test.mjs",
    "test:cloudflare-phase2": "node --test tests/cloudflare-migration-phase2.test.mjs",
    "test:cloudflare-phase3": "node --test tests/cloudflare-migration-phase3.test.mjs",
    "test:cloudflare-phase4": "node --test tests/cloudflare-migration-phase4.test.mjs",
    "d1:phase2:validate": "node scripts/validate-d1-phase2.mjs",
    "d1:phase3:validate": "node scripts/validate-d1-phase3.mjs",
    "d1:phase4:validate": "node scripts/validate-d1-phase4.mjs",
    "d1:hot-indexes:validate": "node scripts/validate-d1-hot-indexes.mjs",
    "phase4:shadow": "node scripts/phase4/production-shadow.mjs",
    "phase4:reconcile": "node scripts/phase4/production-shadow.mjs --reconcile-only",
    "phase4:rollback": "node scripts/phase4/production-shadow.mjs --rollback",
    "ci": "npm run typecheck && npm run lint && npm run test && npm run build",
    "cf:build": "opennextjs-cloudflare build && node scripts/patch-opennext-vercel-og.mjs",
    "cf:preview": "npm run cf:build && opennextjs-cloudflare preview",
    "cf:preview:multi": "npm run cf:build && wrangler dev -c wrangler.web.jsonc -c workers/icai-sync/wrangler.jsonc -c workers/billing/wrangler.jsonc",
    "cf:deploy:icai": "wrangler deploy -c workers/icai-sync/wrangler.jsonc",
    "cf:deploy:billing": "wrangler deploy -c workers/billing/wrangler.jsonc",
    "cf:deploy:web": "opennextjs-cloudflare deploy --config=wrangler.web.jsonc",
    "cf:deploy": "npm run cf:build && npm run cf:deploy:icai && npm run cf:deploy:billing && npm run cf:deploy:web",
    "deploy": "npm run cf:deploy",
    "cf:typegen": "wrangler types --config wrangler.web.jsonc --env-interface CloudflareEnv cloudflare-env.d.ts",
    "cf:check:icai": "node scripts/check-cloudflare-size-budget.mjs --config workers/icai-sync/wrangler.jsonc --budget-mib 1.50",
    "cf:check:billing": "node scripts/check-cloudflare-size-budget.mjs --config workers/billing/wrangler.jsonc --budget-mib 0.75",
    "cf:check:web": "node scripts/check-cloudflare-size-budget.mjs --config wrangler.web.jsonc --budget-mib 3.10",
    "cf:check:phase3": "node scripts/check-cloudflare-size-budget.mjs --config wrangler.phase3.jsonc --budget-mib 3.10",
    "cf:check:phase4": "wrangler deploy --dry-run --config wrangler.phase4.jsonc",
    "cf:check": "npm run cf:build && npm run cf:check:icai && npm run cf:check:billing && npm run cf:check:web",
    "cf:smoke": "node scripts/smoke-cloudflare-runtime.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.5",
    "@supabase/supabase-js": "2.112.4",
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "1.20.4",
    "@types/node": "^22.18.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.39.0",
    "eslint-config-next": "16.3.3",
    "typescript": "^5.9.2",
    "wrangler": "^4.127.1"
  },
  "overrides": {
    "electron-to-chromium": "1.5.420"
  }
}
