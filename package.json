{
  "name": "ca-progress-v2",
  "version": "0.0.1",
  "private": true,
  "engines": { "node": ">=22.13.0" },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "node --test tests/*.test.mjs",
    "test:smoke": "node --test tests/phase0-*.test.mjs",
    "ci": "npm run typecheck && npm run lint && npm run test && npm run build",
    "cf:build": "opennextjs-cloudflare build && node scripts/patch-opennext-vercel-og.mjs",
    "cf:preview": "npm run cf:build && opennextjs-cloudflare preview",
    "cf:preview:multi": "npm run cf:build && wrangler dev -c wrangler.web.jsonc -c workers/icai-sync/wrangler.jsonc -c workers/billing/wrangler.jsonc -c workers/admin-ops/wrangler.jsonc",
    "cf:deploy:icai": "wrangler deploy -c workers/icai-sync/wrangler.jsonc",
    "cf:deploy:billing": "wrangler deploy -c workers/billing/wrangler.jsonc",
    "cf:deploy:admin": "wrangler deploy -c workers/admin-ops/wrangler.jsonc",
    "cf:deploy:web": "opennextjs-cloudflare deploy --config=wrangler.web.jsonc",
    "cf:deploy": "npm run cf:build && npm run cf:deploy:icai && npm run cf:deploy:billing && npm run cf:deploy:admin && npm run cf:deploy:web",
    "deploy": "npm run cf:deploy",
    "cf:typegen": "wrangler types --config wrangler.web.jsonc --env-interface CloudflareEnv cloudflare-env.d.ts",
    "cf:check:icai": "node scripts/check-cloudflare-size-budget.mjs --config workers/icai-sync/wrangler.jsonc --budget-mib 1.50",
    "cf:check:billing": "node scripts/check-cloudflare-size-budget.mjs --config workers/billing/wrangler.jsonc --budget-mib 0.75",
    "cf:check:admin": "node scripts/check-cloudflare-size-budget.mjs --config workers/admin-ops/wrangler.jsonc --budget-mib 1.00",
    "cf:check:web": "node scripts/check-cloudflare-size-budget.mjs --config wrangler.web.jsonc --budget-mib 2.70",
    "cf:check": "npm run cf:build && npm run cf:check:icai && npm run cf:check:billing && npm run cf:check:admin && npm run cf:check:web",
    "cf:smoke": "node scripts/smoke-cloudflare-runtime.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.5",
    "@supabase/supabase-js": "2.112.4",
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "1.20.4",
    "@types/node": "^22.18.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.39.0",
    "eslint-config-next": "16.3.3",
    "typescript": "^5.9.2",
    "wrangler": "^4.127.1"
  }
}
